---
import { getLessons, tracks } from '../data/lessons';
import LessonCard from './LessonCard.astro';
import ProgressBar from './ProgressBar.astro';

const lessons = await getLessons();
---

<div class="pf-wide path not-content">
	<p class="lede pf-muted">
		A suggested order from first principles to production-style labs. Your progress is saved in this browser only.
	</p>
	<ProgressBar slugs={lessons.map((l) => l.slug)} />
	{
		tracks.map((t) => {
			const items = lessons.filter((l) => l.data.track === t.name);
			return (
				items.length > 0 && (
					<section class="track" aria-labelledby={`track-${t.name}`}>
						<h2 id={`track-${t.name}`}>{t.name}</h2>
						<p class="pf-muted track-text">{t.text}</p>
						<ol>
							{items.map((l) => (
								<li>
									<LessonCard lesson={l} />
								</li>
							))}
						</ol>
					</section>
				)
			);
		})
	}
</div>

<style>
	.path {
		max-width: 56rem;
	}
	.path > :global(* + *) {
		margin-top: 2rem;
	}
	.lede {
		max-width: 40rem;
		font-size: 1.05rem;
	}
	.track {
		margin-top: 3rem;
	}
	.track h2 {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.track-text {
		margin-top: 0.25rem;
		max-width: 40rem;
	}
	ol {
		list-style: none;
		margin-top: 1.5rem;
		padding-inline-start: 2rem;
		border-inline-start: 2px dashed var(--pf-border);
	}
	li {
		position: relative;
	}
	li + li {
		margin-top: 1.5rem;
	}
	li::before {
		content: '';
		position: absolute;
		inset-inline-start: calc(-2rem - 11px);
		top: 1.25rem;
		width: 1.25rem;
		height: 1.25rem;
		border: 2px solid var(--pf-primary);
		border-radius: 999px;
		background: var(--sl-color-bg);
	}
</style>
