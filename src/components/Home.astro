---
import { Code } from '@astrojs/starlight/components';
import Icon from './Icon.astro';
import { SITE_NAME } from '../../site.config.mjs';

const tracks = [
	{ icon: 'key', title: 'PKI', text: 'Keys, certificates, CAs and chains of trust — explained plainly, then built for real.' },
	{ icon: 'network', title: 'mTLS', text: 'Make clients and servers prove who they are. Lock down a service with nginx and client certificates.' },
	{ icon: 'wifi', title: 'EAP-TLS', text: 'Join networks with certificates, not passwords, using FreeRADIUS and 802.1X.' },
] as const;
---

<div class="pf-wide home not-content">
	<section class="hero pf-grid-bg">
		<div class="hero-copy">
			<span class="badge"><Icon name="terminal" class="badge-icon" /> Free · Open-source tools · No experience needed</span>
			<h1 id="_top">Learn certificates by <span class="hl">building</span> them.</h1>
			<p class="lede">
				Whether you're curious, studying, or managing systems, {SITE_NAME} walks you from “what is a certificate?” to
				running your own CA, mutual TLS and EAP-TLS — on your own machine.
			</p>
			<div class="actions">
				<a class="pf-btn pf-btn-primary" href="/path/">Start the path <Icon name="arrow" /></a>
				<a class="pf-btn" href="/guides/">Browse guides</a>
			</div>
		</div>
		<div class="hero-code">
			<Code
				lang="sh"
				title="Your first CA, in one command"
				code={`step ca init --name "Lab CA" \\\n  --dns localhost --address 127.0.0.1:9000 \\\n  --provisioner admin@example.com`}
			/>
			<Code
				lang="text"
				title="Expected output (excerpt)"
				code={`✔ Root certificate: ~/.step/certs/root_ca.crt\n✔ Intermediate certificate: ~/.step/certs/intermediate_ca.crt`}
			/>
		</div>
	</section>

	<section class="tracks">
		<h2>Three tracks, one real build</h2>
		<p class="pf-muted intro">
			Each track mixes short explanations with labs you run yourself. Follow them in order, or jump to what you need.
		</p>
		<div class="track-grid">
			{
				tracks.map((t) => (
					<div class="pf-card track">
						<Icon name={t.icon} size="1.5rem" class="track-icon" />
						<h3>{t.title}</h3>
						<p class="pf-muted">{t.text}</p>
					</div>
				))
			}
		</div>
		<div class="cta">
			<div>
				<h3>New to the command line?</h3>
				<p class="pf-muted">Lab Setup walks you through installing everything on Linux, macOS or Windows.</p>
			</div>
			<a href="/setup/">Set up your lab <Icon name="arrow" /></a>
		</div>
	</section>
</div>

<style>
	.home > * + * {
		margin-top: 0;
	}
	.hero {
		display: grid;
		gap: 3rem;
		align-items: center;
		margin-inline: calc(-1 * var(--sl-content-pad-x));
		padding: 3.5rem var(--sl-content-pad-x);
		border-bottom: 1px solid var(--pf-border);
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid var(--pf-border);
		border-radius: 999px;
		background: var(--pf-card);
		padding: 0.25rem 0.75rem;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--pf-muted);
	}
	.badge :global(.badge-icon) {
		color: var(--pf-primary);
	}
	h1 {
		margin-top: 1.5rem;
		font-size: clamp(2.5rem, 7vw, 3.75rem);
		font-weight: 700;
		line-height: 1.05;
		color: var(--sl-color-white);
	}
	.hl {
		color: var(--pf-primary);
	}
	.lede {
		margin-top: 1.5rem;
		max-width: 36rem;
		font-size: 1.125rem;
		line-height: 1.7;
		color: var(--pf-muted);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.hero-code {
		min-width: 0;
	}
	.hero-code > :global(* + *) {
		margin-top: 0.75rem;
	}
	.tracks {
		padding: 4rem 0 1rem;
	}
	.tracks h2 {
		font-size: 1.875rem;
		line-height: 1.2;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.intro {
		margin-top: 0.5rem;
		max-width: 40rem;
	}
	.track-grid {
		display: grid;
		gap: 1.25rem;
		margin-top: 2.5rem;
	}
	.track {
		padding: 1.5rem;
	}
	.track :global(.track-icon) {
		color: var(--pf-primary);
	}
	.track h3 {
		margin-top: 1rem;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.track p {
		margin-top: 0.5rem;
		font-size: 0.875rem;
		line-height: 1.65;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3rem;
		padding: 1.5rem;
		border: 1px solid var(--pf-border);
		border-radius: var(--pf-radius);
		background: var(--pf-accent-bg);
	}
	.cta h3 {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.cta p {
		margin: 0;
		font-size: 0.875rem;
	}
	.cta a {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-weight: 500;
		color: var(--pf-accent-fg);
		text-decoration: none;
	}
	@media (min-width: 50rem) {
		.track-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	@media (min-width: 64rem) {
		.hero {
			grid-template-columns: 1fr 1fr;
			padding-block: 5.5rem;
		}
		.hero-code {
			padding-inline-start: 2rem;
		}
	}
</style>
