---
import Icon from './Icon.astro';
import ChainOfTrust from './ChainOfTrust.astro';
import { SITE_NAME } from '../../site.config.mjs';
import { getLessons, tracks } from '../data/lessons';

// Each track card links to the track's first module and shows how many modules it has.
const lessons = await getLessons();
const trackCards = tracks.map((t) => {
	const items = lessons.filter((l) => l.data.track === t.name);
	return { ...t, count: items.length, href: items[0]?.href ?? '/path/' };
});
---

<div class="pf-wide home not-content">
	<section class="hero">
		<div class="hero-copy">
			<span class="badge"><Icon name="terminal" class="badge-icon" /> Free · Open-source tools · No experience needed</span>
			<h1 id="_top">Learn certificates by <span class="hl">building</span> them.</h1>
			<p class="lede">
				Whether you're curious, studying, or managing systems, {SITE_NAME} walks you from “what is a certificate?” to
				running your own <a href="/glossary/#ca-certificate-authority">certificate authority (CA)</a>: the service that
				signs certificates. Then you use it for mutual TLS, EAP-TLS and more, on your own machine.
			</p>
			<div class="actions">
				<a class="pf-btn pf-btn-primary" href="/path/">Start the path <Icon name="arrow" /></a>
				<a class="pf-btn" href="/guides/">Browse all modules</a>
			</div>
		</div>
		<div class="hero-art">
			<ChainOfTrust />
		</div>
	</section>

	<section class="tracks">
		<h2>Five tracks, one CA</h2>
		<p class="pf-muted intro">
			Each track mixes short explanations with labs you run yourself. Every track uses the CA you build in Core. Follow them in order, or jump to what you need.
		</p>
		<div class="track-grid">
			{
				trackCards.map((t) => (
					<a class="pf-card track" href={t.href}>
						<span class="track-tile">
							<Icon name={t.icon} size="1.35rem" />
						</span>
						<h3>{t.name}</h3>
						<p class="pf-muted">{t.text}</p>
						<span class="track-foot">
							<span class="count">
								{t.count} {t.count === 1 ? 'module' : 'modules'}
							</span>
							<span class="start">
								Start <Icon name="arrow" />
							</span>
						</span>
					</a>
				))
			}
		</div>
		<div class="cta">
			<div>
				<h3>New to the command line?</h3>
				<p class="pf-muted">Lab Setup walks you through installing everything on Linux, macOS or Windows.</p>
			</div>
			<a href="/setup/">Set up your lab <Icon name="arrow" /></a>
		</div>
	</section>
</div>

<style>
	.home > * + * {
		margin-top: 0;
	}
	.hero {
		display: grid;
		gap: 3rem;
		align-items: center;
		margin-inline: calc(-1 * var(--sl-content-pad-x));
		padding: 3.5rem var(--sl-content-pad-x);
		position: relative;
		isolation: isolate;
	}
	/* The grid fades out toward every edge instead of ending in a hard line. */
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			linear-gradient(var(--pf-grid-line) 1px, transparent 1px),
			linear-gradient(90deg, var(--pf-grid-line) 1px, transparent 1px);
		background-size: 32px 32px;
		-webkit-mask-image: radial-gradient(ellipse closest-side at 50% 45%, #000 30%, transparent 100%);
		mask-image: radial-gradient(ellipse closest-side at 50% 45%, #000 30%, transparent 100%);
		pointer-events: none;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid var(--pf-border);
		border-radius: 999px;
		background: var(--pf-card);
		padding: 0.25rem 0.75rem;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--pf-muted);
	}
	.badge :global(.badge-icon) {
		color: var(--pf-primary);
	}
	h1 {
		margin-top: 1.5rem;
		font-size: clamp(2.5rem, 7vw, 3.75rem);
		font-weight: 700;
		line-height: 1.05;
		color: var(--sl-color-white);
	}
	.hl {
		color: var(--pf-primary);
	}
	.lede {
		margin-top: 1.5rem;
		max-width: 36rem;
		font-size: 1.125rem;
		line-height: 1.7;
		color: var(--pf-muted);
	}
	.lede a {
		color: var(--sl-color-text-accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.hero-art {
		min-width: 0;
	}
	.tracks {
		padding: 4rem 0 1rem;
	}
	.tracks h2 {
		font-size: 1.875rem;
		line-height: 1.2;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.intro {
		margin-top: 0.5rem;
		max-width: 40rem;
	}
	.track-grid {
		display: grid;
		gap: 1.25rem;
		margin-top: 2.5rem;
	}
	.track {
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		color: inherit;
		text-decoration: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		.track {
			transition:
				transform 0.15s,
				border-color 0.15s,
				box-shadow 0.15s;
		}
	}
	.track:hover {
		transform: translateY(-3px);
		border-color: color-mix(in oklab, var(--pf-primary) 45%, var(--pf-border));
		box-shadow:
			var(--pf-shadow),
			0 12px 28px -16px color-mix(in oklab, var(--pf-primary) 55%, transparent);
	}
	.track:focus-visible {
		outline: 2px solid var(--pf-primary);
		outline-offset: 3px;
	}
	.track-tile {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.7rem;
		background: color-mix(in oklab, var(--pf-primary) 16%, transparent);
		color: var(--pf-primary);
	}
	.track:hover .track-tile {
		background: var(--pf-primary);
		color: var(--pf-primary-fg);
	}
	.track h3 {
		margin-top: 1rem;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.track p {
		margin-top: 0.5rem;
		font-size: 0.875rem;
		line-height: 1.65;
	}
	.track-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: auto;
		padding-top: 1.25rem;
		font-size: 0.8rem;
	}
	.count {
		color: var(--pf-muted);
	}
	.start {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}
	@media (prefers-reduced-motion: no-preference) {
		.start :global(svg) {
			transition: transform 0.15s;
		}
	}
	.track:hover .start :global(svg) {
		transform: translateX(3px);
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3rem;
		padding: 1.5rem;
		border: 1px solid var(--pf-border);
		border-radius: var(--pf-radius);
		background: var(--pf-accent-bg);
	}
	.cta h3 {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.cta p {
		margin: 0;
		font-size: 0.875rem;
	}
	.cta a {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-weight: 500;
		color: var(--pf-accent-fg);
		text-decoration: none;
	}
	@media (min-width: 50rem) {
		.track-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	@media (min-width: 72rem) {
		.track-grid {
			grid-template-columns: repeat(5, 1fr);
		}
	}
	@media (min-width: 64rem) {
		.hero {
			grid-template-columns: 1fr 1fr;
			padding-block: 5.5rem;
		}
		.hero-art {
			padding-inline-start: 2rem;
		}
	}
</style>
