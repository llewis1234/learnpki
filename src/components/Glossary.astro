---
import { glossary } from '../data/glossary';

const terms = [...glossary].sort((a, b) => a.term.localeCompare(b.term));
---

<div class="glossary not-content">
	<label class="search" hidden>
		<span class="sr-only">Search terms</span>
		<input type="search" placeholder="Search terms…" autocomplete="off" />
	</label>
	<dl>
		{
			terms.map((t) => (
				<div class="entry pf-card" data-search={`${t.term} ${t.def}`.toLowerCase()}>
					<dt>{t.term}</dt>
					<dd>{t.def}</dd>
				</div>
			))
		}
	</dl>
	<p class="empty pf-muted" hidden>No terms match.</p>
</div>

<script>
	const root = document.querySelector<HTMLElement>('.glossary');
	if (root) {
		const label = root.querySelector<HTMLElement>('.search')!;
		const input = label.querySelector('input')!;
		const entries = [...root.querySelectorAll<HTMLElement>('.entry')];
		const empty = root.querySelector<HTMLElement>('.empty')!;
		label.hidden = false;
		input.addEventListener('input', () => {
			const q = input.value.trim().toLowerCase();
			let shown = 0;
			for (const e of entries) {
				const match = !q || e.dataset.search!.includes(q);
				e.hidden = !match;
				if (match) shown++;
			}
			empty.hidden = shown > 0;
		});
	}
</script>

<style>
	.search {
		display: block;
	}
	.search[hidden],
	.entry[hidden] {
		display: none;
	}
	input {
		width: 100%;
		max-width: 28rem;
		border: 1px solid var(--pf-border);
		border-radius: 0.6rem;
		background: var(--pf-card);
		color: var(--sl-color-white);
		padding: 0.6rem 0.9rem;
		font: inherit;
	}
	input:focus {
		outline: 2px solid var(--pf-primary);
		outline-offset: 1px;
	}
	dl {
		display: grid;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	.entry {
		margin: 0;
		padding: 1rem 1.15rem;
	}
	dt {
		font-family: var(--pf-font-display);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	dd {
		margin: 0.25rem 0 0;
		font-size: 0.925rem;
		line-height: 1.6;
		color: var(--pf-muted);
	}
</style>
