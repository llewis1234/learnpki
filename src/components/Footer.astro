---
import Default from '@astrojs/starlight/components/Footer.astro';
import FlashCards from './FlashCards.astro';
import Icon from './Icon.astro';
import { SITE_NAME, SITE_URL, REPO_URL } from '../../site.config.mjs';

const { id, data } = Astro.locals.starlightRoute.entry;
const isLesson = id.startsWith('guides/') && data.module !== undefined;
const slug = id.replace(/^guides\//, '');

// "Report a problem" opens a new GitHub issue with this page's URL filled in.
const pageUrl = new URL(Astro.url.pathname, SITE_URL).href;
const issueUrl = `${REPO_URL}/issues/new?${new URLSearchParams({
	title: `Problem on ${Astro.url.pathname}`,
	body: `Page: ${pageUrl}\n\nWhat is wrong:\n\nWhat you expected:\n`,
})}`;
---

{
	isLesson && (
		<div class="lesson-end">
			{data.cards.length > 0 && <FlashCards cards={data.cards} />}
			<button type="button" class="complete" data-mark-complete={slug} aria-pressed="false">
				<Icon name="check" /> <span data-label>Mark complete</span>
			</button>
			<p class="pf-muted note">Progress is saved in this browser only.</p>
		</div>
	)
}

<Default><slot /></Default>

<footer class="site-footer-note">
	<div class="about">
		<p class="brand">{SITE_NAME}</p>
		<p>Learn certificates by building with open-source tools.</p>
		<p>An independent project. Not affiliated with or endorsed by Smallstep, FreeRADIUS or nginx.</p>
		<p>
			Code and labs: <a href="https://www.apache.org/licenses/LICENSE-2.0">Apache-2.0</a>. Lesson text:{' '}
			<a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>.
		</p>
	</div>
	<nav aria-label="Footer">
		<ul>
			<li><a href={issueUrl}>Report a problem</a></li>
			<li><a href="/glossary/">Glossary</a></li>
			<li><a href="/about/">About</a></li>
			<li><a href={REPO_URL}>Source on GitHub</a></li>
			<li><a href="#_top">Back to top <span aria-hidden="true">↑</span></a></li>
		</ul>
	</nav>
</footer>

<style>
	.lesson-end {
		margin-top: 3rem;
	}
	.complete {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 2rem;
		border: 1px solid var(--pf-border);
		border-radius: 0.75rem;
		background: var(--pf-card);
		color: var(--sl-color-white);
		padding: 0.65rem 1.1rem;
		font: inherit;
		font-weight: 500;
		cursor: pointer;
		box-shadow: var(--pf-shadow);
	}
	.complete:hover {
		background: var(--pf-secondary);
	}
	.complete[aria-pressed='true'] {
		background: var(--pf-primary);
		border-color: var(--pf-primary);
		color: var(--pf-primary-fg);
	}
	.note {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
	}
	.site-footer-note {
		display: grid;
		gap: 1.5rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--pf-border);
		color: var(--pf-muted);
		font-size: var(--sl-text-xs);
		line-height: 1.6;
	}
	.site-footer-note p {
		margin: 0.2rem 0 0;
	}
	.brand {
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.site-footer-note a {
		color: var(--sl-color-text-accent);
	}
	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	nav li {
		margin: 0;
	}
	nav a {
		color: var(--pf-muted) !important;
		text-decoration: none;
	}
	nav a:hover {
		color: var(--sl-color-white) !important;
		text-decoration: underline;
	}
	@media (min-width: 50rem) {
		.site-footer-note {
			grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
			align-items: start;
		}
		nav ul {
			justify-content: flex-end;
		}
	}
</style>
